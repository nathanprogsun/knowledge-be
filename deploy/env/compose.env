# Local compose credentials. Not for production. Compose services load
# this file; hostnames are overridden to the compose DNS names.

APP_NAME=knowledge-be
ENVIRONMENT=development

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=knowledge_be
DB_DRIVER=postgresql+asyncpg

REDIS_URL=redis://redis:6379

JWT_SECRET_KEY=local-compose-jwt-secret-not-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
DB_CONN_PREWARM=true

CORS_ALLOW_ORIGINS=["*"]

# Parse is in-process. Unused unless a DocReaderAdapter is injected.
# WeKnora's docreader image is intentionally not in this compose.
DOCREADER_ADDR=localhost:50051
DOCREADER_TRANSPORT=grpc

DEFAULT_MAIN_THREAD_POOL_SIZE=40

# Exactly 32 ASCII bytes (see src/util/crypto.py).
SYSTEM_AES_KEY=0123456789abcdef0123456789abcdef

RBAC_ENFORCED=true
CROSS_TENANT_ACCESS_ENABLED=false

# Compose stack can mint the default account without a pre-seeded user.
AUTO_SETUP_ENABLED=true

# Default storage path (api/worker mount files_data here).
LOCAL_STORAGE_BASE_DIR=/data/files

# Default retrieve path matches WeKnora: vectors in Postgres/pgvector.
RETRIEVE_DRIVER=postgres

# Skills sandbox. ``local`` needs no image. ``docker`` needs
# ``docker compose --profile sandbox`` (builds knowledge-be-sandbox:local)
# and docker.sock (mounted by compose).
KB_SANDBOX_MODE=local
KB_SANDBOX_DOCKER_IMAGE=knowledge-be-sandbox:local
# KB_SKILL_DIRS=/skills

# MinIO (used when `docker compose --profile minio|full up`).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-be

# Neo4j (used when `--profile neo4j|full`). Set NEO4J_ENABLE=true to open
# the graph repository at process start.
NEO4J_ENABLE=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Qdrant / Milvus / Weaviate / Doris
QDRANT_HOST=qdrant
QDRANT_PORT=6334
MILVUS_ADDRESS=milvus:19530
WEAVIATE_HOST=weaviate:8080
WEAVIATE_GRPC_ADDRESS=weaviate:50051
WEAVIATE_SCHEME=http
DORIS_ADDR=doris-fe:9030
DORIS_HTTP_PORT=8030
DORIS_DATABASE=knowledge_be
DORIS_USERNAME=root
DORIS_PASSWORD=

# OpenDataLoader hybrid PDF backend (`--profile odl-hybrid`, build WITH_ODL=1).
ODL_HYBRID_URL=http://odl-hybrid:5002
ODL_HYBRID=docling-fast

# Dex local IdP (`--profile dex|full`). Enable OIDC in the API after up:
# OIDC_ENABLE=true
# OIDC_ISSUER_URL=http://127.0.0.1:5556/dex
# OIDC_CLIENT_ID=knowledge-be
# OIDC_CLIENT_SECRET=knowledge-be-dex-local-secret

# Langfuse (`--profile langfuse`): register in the UI, then point OTEL at
# Langfuse's OTLP endpoint (Basic auth = public:secret base64).
# OTEL_ENABLED=true
# OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel

# MCP server (`--profile mcp|full`): mint a tenant API key, set
# KNOWLEDGE_BE_API_KEY, then Cursor → http://127.0.0.1:8082 with
# MCP_SERVER_AUTH_TOKEN.
MCP_SERVER_AUTH_TOKEN=knowledge-be-local-mcp-token
