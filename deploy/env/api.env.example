# Compose env_file for production-shaped deploys. Placeholders only;
# never commit real secrets. Local `docker compose up` uses
# deploy/env/compose.env instead.

APP_NAME=knowledge-be
ENVIRONMENT=development

DB_USER=postgres
DB_PASSWORD=<required>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledge_be
DB_DRIVER=postgresql+asyncpg

# Settings field: database_url_override. Env name: DATABASE_URL_OVERRIDE.
# Settings uses extra="ignore", so a bare DATABASE_URL is silently dropped.
# DATABASE_URL_OVERRIDE=postgresql+asyncpg://postgres:postgres@postgres:5432/knowledge_be

REDIS_URL=redis://localhost:6379

# Must-set for real deploys.
JWT_SECRET_KEY=<required>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
DB_CONN_PREWARM=true

CORS_ALLOW_ORIGINS=["*"]

# Optional remote reader. The worker default is in-process and ignores this.
DOCREADER_ADDR=localhost:50051
DOCREADER_TRANSPORT=grpc

DEFAULT_MAIN_THREAD_POOL_SIZE=40

# Must-set for real deploys. Raw 32-byte UTF-8 string (32 ASCII
# characters). Not hex-decoded. Generate: python -c "import secrets; print(secrets.token_hex(16))"
SYSTEM_AES_KEY=<required>

RBAC_ENFORCED=true
CROSS_TENANT_ACCESS_ENABLED=false
