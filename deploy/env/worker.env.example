# Compose env_file for the worker service. Placeholders only; never
# commit real secrets. Compose overrides DB_HOST=postgres and
# REDIS_URL=redis://redis:6379.
#
# The worker uses REDIS_URL when WORKER_REDIS_URL is unset. Optional
# WORKER_* knobs live in deploy/k8s/worker-configmap.yaml.

REDIS_URL=redis://localhost:6379
# WORKER_REDIS_URL=redis://localhost:6379

DB_USER=postgres
DB_PASSWORD=<required>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledge_be
DB_DRIVER=postgresql+asyncpg

# Must-set for real deploys. Raw 32-byte UTF-8 string (32 ASCII
# characters). Not hex-decoded. Generate: python -c "import secrets; print(secrets.token_hex(16))"
SYSTEM_AES_KEY=<required>
