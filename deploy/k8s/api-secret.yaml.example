apiVersion: v1
kind: Secret
metadata:
  name: kb-api-secret
  labels:
    app.kubernetes.io/name: knowledge-be
    app.kubernetes.io/component: api
type: Opaque
stringData:
  # Replace with real values before applying — do NOT commit the populated file.
  DB_USER: "<replace-with-db-user>"
  DB_PASSWORD: "<replace-with-db-password>"
  REDIS_URL: "<replace-with-redis-url>"
  JWT_SECRET_KEY: "<replace-with-random-64-char-string>"
  # Raw 32-byte key (32 UTF-8 bytes), same as crypto.py. Not hex-decoded, not AES-128.
  SYSTEM_AES_KEY: "<replace-with-raw-32-byte-key>"
  OIDC_CLIENT_SECRET: "<replace-with-oidc-client-secret-if-using-oidc>"