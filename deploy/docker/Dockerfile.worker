# syntax=docker/dockerfile:1
# Alias for the shared worker target. Canonical command:
#   docker build -f deploy/docker/Dockerfile --target worker -t knowledge-be-worker .
#
# `docker build -f deploy/docker/Dockerfile.worker` still produces that image.

FROM python:3.11-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY alembic ./alembic
COPY alembic.ini ./

RUN uv sync --frozen --no-dev --no-editable

CMD ["python", "-m", "src.workers.main"]
