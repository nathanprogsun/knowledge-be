# knowledge-be local environment template.
# Copy to `.env` and edit values for your machine. Never commit `.env`.

APP_NAME=knowledge-be
ENVIRONMENT=development

# Database — connection parts (auto-composed into DATABASE_URL).
# Password is URL-encoded internally, so reserved characters (e.g.
# `!`, `@`, `#`) round-trip safely.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledge_be
DB_DRIVER=postgresql+asyncpg

# Optional: override the auto-composed URL by setting DATABASE_URL
# directly. Useful for managed Postgres (RDS, Cloud SQL) or non-default
# sslmode / channel_binding settings.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_be

# Redis (ARQ broker + cache)
REDIS_URL=redis://localhost:6379

# JWT auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

# DB pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
DB_CONN_PREWARM=true

# CORS
CORS_ALLOW_ORIGINS=["*"]

# docreader gRPC service (independent process)
DOCREADER_ADDR=localhost:50051
DOCREADER_TRANSPORT=grpc

# Misc
DEFAULT_MAIN_THREAD_POOL_SIZE=40
SYSTEM_AES_KEY=