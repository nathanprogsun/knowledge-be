# knowledge-be local environment template.
# Copy to `.env` and edit values for your machine. Never commit `.env`.

KNOWLEDGE_BE_APP_NAME=knowledge-be
KNOWLEDGE_BE_ENVIRONMENT=development

# PostgreSQL — async driver; URL must use the asyncpg dialect.
KNOWLEDGE_BE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_be

# Redis (ARQ broker + cache)
KNOWLEDGE_BE_REDIS_URL=redis://localhost:6379

# JWT auth
KNOWLEDGE_BE_JWT_SECRET_KEY=change-me-in-production
KNOWLEDGE_BE_JWT_ALGORITHM=HS256
KNOWLEDGE_BE_JWT_EXPIRE_MINUTES=10080
KNOWLEDGE_BE_REFRESH_TOKEN_EXPIRE_DAYS=7

# DB pool tuning
KNOWLEDGE_BE_DB_POOL_SIZE=10
KNOWLEDGE_BE_DB_MAX_OVERFLOW=20
KNOWLEDGE_BE_DB_ECHO=false
KNOWLEDGE_BE_DB_CONN_PREWARM=true

# CORS
KNOWLEDGE_BE_CORS_ALLOW_ORIGINS=["*"]

# docreader gRPC service (independent process)
KNOWLEDGE_BE_DOCREADER_ADDR=localhost:50051
KNOWLEDGE_BE_DOCREADER_TRANSPORT=grpc

# Misc
KNOWLEDGE_BE_DEFAULT_MAIN_THREAD_POOL_SIZE=40
KNOWLEDGE_BE_SYSTEM_AES_KEY=