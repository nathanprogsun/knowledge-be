# knowledge-be local environment template.
# Copy to `.env` and edit values for your machine. Never commit `.env`.

APP_NAME=knowledge-be
ENVIRONMENT=development

# Database connection parts. Combined into the runtime URL unless
# DATABASE_URL_OVERRIDE is set. Password is URL-encoded internally,
# so reserved characters (e.g. `!`, `@`, `#`) round-trip safely.
DB_USER=postgres
DB_PASSWORD=<required>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledge_be
DB_DRIVER=postgresql+asyncpg

# Optional override of the auto-composed URL. Settings field:
# database_url_override. Env name: DATABASE_URL_OVERRIDE. Settings
# uses extra="ignore", so a bare DATABASE_URL is silently dropped.
# DATABASE_URL_OVERRIDE=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_be

# Redis (ARQ broker + cache). The worker uses REDIS_URL when
# WORKER_REDIS_URL is unset. Optional WORKER_* knobs live in
# deploy/k8s/worker-configmap.yaml.
REDIS_URL=redis://localhost:6379

# JWT auth. JWT_SECRET_KEY is must-set for real deploys.
JWT_SECRET_KEY=<required>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

# DB pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
DB_CONN_PREWARM=true

# CORS
CORS_ALLOW_ORIGINS=["*"]

# docreader gRPC service (independent process)
DOCREADER_ADDR=localhost:50051
DOCREADER_TRANSPORT=grpc

# Misc
DEFAULT_MAIN_THREAD_POOL_SIZE=40

# Must-set for real deploys. Raw 32-byte UTF-8 string (32 ASCII
# characters). Not hex-decoded. `openssl rand -base64 32` is 44 chars
# and get_aes_key() treats it as unset. Generate 32 ASCII bytes:
#   python -c "import secrets; print(secrets.token_hex(16))"
SYSTEM_AES_KEY=<required>

# Role guards reject unauthorized calls when true. Cross-tenant
# superuser routes (/tenants/all, /search) stay closed unless enabled.
RBAC_ENFORCED=true
CROSS_TENANT_ACCESS_ENABLED=false

# Tracing. Off keeps local boot at zero OTel cost. With no OTLP
# endpoint, spans go to the console exporter; `file` writes NDJSON
# under OTEL_FILE_DIR for local jq/grep.
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=knowledge-be
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER=console
# OTEL_FILE_DIR=traces

# SSO. Leave endpoints blank when OIDC_DISCOVERY_URL is set; the client
# fills them from the discovery document at request time.
# OIDC_ENABLE=false
# OIDC_ISSUER_URL=
# OIDC_DISCOVERY_URL=
# OIDC_PROVIDER_DISPLAY_NAME=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_USER_INFO_ENDPOINT=
# OIDC_SCOPES=["openid", "profile", "email"]
# OIDC_REDIRECT_ALLOWED_HOSTS=[]
# OIDC_USER_INFO_MAPPING_USERNAME=name
# OIDC_USER_INFO_MAPPING_EMAIL=email

# Header auth asserts identity and roles from these headers. Leave off
# unless a trusted gateway strips or overwrites them on every request.
# AUTO_SETUP_ENABLED gates unauthenticated /auth/auto-setup.
# HEADER_AUTH_ENABLED=false
# AUTO_SETUP_ENABLED=false
# AUTH_HEADER_USER_ID=X-User-Id
# AUTH_HEADER_TENANT_ID=X-Tenant-ID
# AUTH_HEADER_ROLES=X-Roles
