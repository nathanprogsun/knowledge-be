{
  "_comment": "Worker task wire shapes captured from the upstream Go task payload structs (internal/types/task.go, internal/types/datasource.go, internal/types/temporary_document.go, internal/application/service/extract.go and internal/application/service/wiki_ingest.go). Each tasks entry lists: go_type (the upstream task-type constant), go_struct (the upstream payload struct), fields (the business JSON field set the upstream payload carries — the upstream tracing-context lf_* fields and the initiator metadata are deliberately not modelled on the Python surface, so they are excluded from the comparison), required (the upstream fields serialized without omitempty), and result (the JSON keys the Python handler returns; empty for tasks whose core seam is not yet wired). Field name comparison is exact (no drift in either direction).",
  "tasks": {
    "chunk:extract": {
      "go_type": "chunk:extract",
      "go_struct": "ExtractChunkPayload",
      "fields": ["tenant_id", "chunk_id", "model_id", "knowledge_id", "attempt", "chunk_index"],
      "required": ["tenant_id", "chunk_id", "model_id"],
      "result": ["skipped", "reason", "node_count", "relation_count"]
    },
    "datasource_sync": {
      "go_type": "datasource:sync",
      "go_struct": "DataSourceSyncPayload",
      "fields": ["data_source_id", "tenant_id", "sync_log_id", "force_full", "max_items", "trigger"],
      "required": ["data_source_id", "tenant_id", "sync_log_id", "force_full"],
      "result": [
        "id", "data_source_id", "tenant_id", "status", "started_at", "finished_at",
        "items_total", "items_created", "items_updated", "items_deleted",
        "items_skipped", "items_failed", "error_message", "result", "created_at",
        "updated_at"
      ]
    },
    "datatable:summary": {
      "go_type": "datatable:summary",
      "go_struct": "DataTableSummaryPayload",
      "fields": ["tenant_id", "knowledge_id", "summary_model", "embedding_model"],
      "required": ["tenant_id", "knowledge_id", "summary_model", "embedding_model"],
      "result": ["knowledge_id", "summary_chunk_id", "column_chunk_id"]
    },
    "document_process": {
      "go_type": "document:process",
      "go_struct": "DocumentProcessPayload",
      "fields": [
        "request_id", "tenant_id", "knowledge_id", "knowledge_base_id",
        "file_path", "file_name", "file_type", "url", "file_url", "passages",
        "enable_multimodel", "enable_question_generation", "question_count",
        "language", "attempt"
      ],
      "required": [
        "request_id", "tenant_id", "knowledge_id", "knowledge_base_id",
        "enable_multimodel", "enable_question_generation"
      ],
      "result": [
        "parse_status", "enable_status", "summary_status", "storage_size",
        "error_message", "text_chunk_count", "skipped"
      ]
    },
    "faq:import": {
      "go_type": "faq:import",
      "go_struct": "FAQImportPayload",
      "fields": [
        "tenant_id", "task_id", "kb_id", "knowledge_id", "entries", "entries_url",
        "entry_count", "mode", "dry_run", "enqueued_at", "instance_id"
      ],
      "required": ["tenant_id", "task_id", "kb_id", "mode", "dry_run", "enqueued_at"],
      "result": []
    },
    "image_multimodal": {
      "go_type": "image:multimodal",
      "go_struct": "ImageMultimodalPayload",
      "fields": [
        "tenant_id", "knowledge_id", "knowledge_base_id", "chunk_id", "image_url",
        "image_local_path", "enable_ocr", "enable_caption", "language",
        "image_source_type", "attempt", "image_index"
      ],
      "required": [
        "tenant_id", "knowledge_id", "knowledge_base_id", "chunk_id", "image_url",
        "image_local_path", "enable_ocr", "enable_caption"
      ],
      "result": [
        "ocr_text", "caption", "image_bytes", "chunks_created", "indexed",
        "skipped", "read_error", "ocr_error", "caption_error", "vlm_model_id",
        "ocr_chars", "caption_chars", "ocr_skipped"
      ]
    },
    "index:delete": {
      "go_type": "index:delete",
      "go_struct": "IndexDeletePayload",
      "fields": [
        "tenant_id", "knowledge_base_id", "embedding_model_id", "kb_type",
        "chunk_ids", "effective_engines", "vector_store_id"
      ],
      "required": [
        "tenant_id", "knowledge_base_id", "embedding_model_id", "kb_type",
        "chunk_ids", "effective_engines"
      ],
      "result": []
    },
    "kb:clone": {
      "go_type": "kb:clone",
      "go_struct": "KBClonePayload",
      "fields": ["tenant_id", "task_id", "source_id", "target_id"],
      "required": ["tenant_id", "task_id", "source_id", "target_id"],
      "result": ["task_id", "source_id", "target_id", "status"]
    },
    "kb:delete": {
      "go_type": "kb:delete",
      "go_struct": "KBDeletePayload",
      "fields": [
        "tenant_id", "knowledge_base_id", "data_source_ids", "effective_engines",
        "vector_store_id"
      ],
      "required": ["tenant_id", "knowledge_base_id", "effective_engines"],
      "result": [
        "knowledge_base_id", "knowledge_ids", "deleted_chunks", "deleted_knowledge",
        "vector_store_id", "status"
      ]
    },
    "knowledge:list_delete": {
      "go_type": "knowledge:list_delete",
      "go_struct": "KnowledgeListDeletePayload",
      "fields": ["tenant_id", "knowledge_ids"],
      "required": ["tenant_id", "knowledge_ids"],
      "result": ["deleted"]
    },
    "knowledge:list_reparse": {
      "go_type": "knowledge:list_reparse",
      "go_struct": "KnowledgeListReparsePayload",
      "fields": ["tenant_id", "knowledge_ids", "process_config"],
      "required": ["tenant_id", "knowledge_ids"],
      "result": ["submitted", "failed"]
    },
    "knowledge:move": {
      "go_type": "knowledge:move",
      "go_struct": "KnowledgeMovePayload",
      "fields": [
        "tenant_id", "task_id", "knowledge_ids", "source_kb_id", "target_kb_id", "mode"
      ],
      "required": [
        "tenant_id", "task_id", "knowledge_ids", "source_kb_id", "target_kb_id", "mode"
      ],
      "result": ["processed", "failed"]
    },
    "knowledge:post_process": {
      "go_type": "knowledge:post_process",
      "go_struct": "KnowledgePostProcessPayload",
      "fields": ["tenant_id", "knowledge_id", "knowledge_base_id", "language", "attempt"],
      "required": ["tenant_id", "knowledge_id", "knowledge_base_id"],
      "result": [
        "skipped", "reason", "chunks_total", "enqueued_summary",
        "enqueued_question", "enqueued_question_count", "enqueued_wiki",
        "wiki_slot_owned", "enqueued_graph", "enqueued_graph_count"
      ]
    },
    "manual_process": {
      "go_type": "manual:process",
      "go_struct": "ManualProcessPayload",
      "fields": [
        "request_id", "tenant_id", "knowledge_id", "knowledge_base_id", "content",
        "need_cleanup"
      ],
      "required": [
        "request_id", "tenant_id", "knowledge_id", "knowledge_base_id", "content",
        "need_cleanup"
      ],
      "result": []
    },
    "question:generation": {
      "go_type": "question:generation",
      "go_struct": "QuestionGenerationPayload",
      "fields": [
        "tenant_id", "knowledge_base_id", "knowledge_id", "question_count",
        "language", "attempt", "chunk_ids", "chunk_id", "batch_index",
        "prev_chunk_id", "next_chunk_id"
      ],
      "required": ["tenant_id", "knowledge_base_id", "knowledge_id", "question_count"],
      "result": []
    },
    "summary:generation": {
      "go_type": "summary:generation",
      "go_struct": "SummaryGenerationPayload",
      "fields": [
        "tenant_id", "knowledge_base_id", "knowledge_id", "language", "refresh",
        "attempt"
      ],
      "required": ["tenant_id", "knowledge_base_id", "knowledge_id"],
      "result": []
    },
    "temporary_document:process": {
      "go_type": "temporary_document:process",
      "go_struct": "TemporaryDocumentTaskPayload",
      "fields": ["tenant_id", "document_id"],
      "required": ["tenant_id", "document_id"],
      "result": ["tenant_id", "document_id", "status"]
    },
    "wiki:finalize": {
      "go_type": "wiki:finalize",
      "go_struct": "WikiIngestPayload",
      "fields": ["tenant_id", "knowledge_base_id", "language"],
      "required": ["tenant_id", "knowledge_base_id"],
      "result": []
    },
    "wiki:ingest": {
      "go_type": "wiki:ingest",
      "go_struct": "WikiIngestPayload",
      "fields": ["tenant_id", "knowledge_base_id", "language"],
      "required": ["tenant_id", "knowledge_base_id"],
      "result": [
        "pending_ops", "ingest_succeeded", "ingest_failed", "retract_handled",
        "pages_affected", "follow_up_scheduled", "rate_limited"
      ]
    }
  },
  "samples": {
